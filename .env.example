# Theogony — example environment file
#
# Copy to `.env` (which is gitignored) and fill in your own values.
# Never commit a real `.env`. SecretStr fields keep these out of repr/log.
#
# Reference: docs/IMPLEMENTATION_PLAN_GEN1.md §3.6 (Configuration & secrets).

# ---------------------------------------------------------------------------
# LLM provider API keys (read by their canonical, un-prefixed names so the
# rest of your tooling — e.g. `gcloud`, the OpenAI CLI — can share them).
# Primary is OpenAI (gpt-4o-mini) by default; Anthropic is the default
# fallback, so for full behaviour set both keys.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# LLM provider selection (Plan §3.3a). Default: openai (gpt-4o-mini) +
# anthropic fallback (claude-sonnet-4-6).
# THEOGONY_LLM__PROVIDER ∈ {gemini, openai, anthropic, stub}
# THEOGONY_LLM__FALLBACK_PROVIDER=anthropic  (or gemini, openai, …; omit/None to skip)
# ---------------------------------------------------------------------------

# THEOGONY_LLM__PROVIDER=openai
# THEOGONY_LLM__MODEL_ID=gpt-4o-mini
# THEOGONY_LLM__FALLBACK_MODEL_ID=
# THEOGONY_LLM__PROVIDER=anthropic
# THEOGONY_LLM__MODEL_ID=claude-sonnet-4-6
# THEOGONY_LLM__TIMEOUT_S=30.0
# THEOGONY_LLM__MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Embedding model (Plan §3.2). Default: BAAI/bge-small-en-v1.5 @ 384 dim.
# Recorded on every node as `embedding_model_id` (Plan §9.3).
# ---------------------------------------------------------------------------

# THEOGONY_EMBEDDING__MODEL_ID=BAAI/bge-small-en-v1.5
# THEOGONY_EMBEDDING__DIM=384

# ---------------------------------------------------------------------------
# Neo4j KnowledgeStore backend (Plan §3.1). Local docker-compose defaults.
# ---------------------------------------------------------------------------

# THEOGONY_NEO4J__URI=bolt://localhost:7687
# THEOGONY_NEO4J__USER=neo4j
# THEOGONY_NEO4J__PASSWORD=changeme
# THEOGONY_NEO4J__DATABASE=neo4j

# ---------------------------------------------------------------------------
# Reporting (Plan §2.11). Defaults match Plan §2.11.2 / §4.1 baselines.
# Tunable so the future Reviewer agent (PHX-0035) can re-calibrate
# from observed data without code changes.
# ---------------------------------------------------------------------------

# Verdict thresholds:
# THEOGONY_REPORT__THRESHOLDS__INGEST__POOR_PARSE_ERROR_RATE=0.20
# THEOGONY_REPORT__THRESHOLDS__INGEST__PARTIAL_PARSE_ERROR_RATE=0.05
# THEOGONY_REPORT__THRESHOLDS__INGEST__POOR_LOW_TIER_RATIO=0.60
# THEOGONY_REPORT__THRESHOLDS__INGEST__PARTIAL_LOW_TIER_RATIO=0.30
# THEOGONY_REPORT__THRESHOLDS__INGEST__POOR_ANOMALY_COUNT=3
# THEOGONY_REPORT__THRESHOLDS__QUERY__POOR_LATENCY_MS=10000
# THEOGONY_REPORT__THRESHOLDS__QUERY__PARTIAL_LATENCY_MS=5000
# THEOGONY_REPORT__THRESHOLDS__QUERY__GOOD_HIGH_CONF_RATIO=0.5
# THEOGONY_REPORT__THRESHOLDS__QUERY__PARTIAL_GAPS_COUNT=3
# THEOGONY_REPORT__THRESHOLDS__ONEIROS__POOR_MEDIAN_VITALITY_SHIFT=-0.05

# Anomaly rules:
# THEOGONY_REPORT__ANOMALY__STAGE_SLOW_MULTIPLIER=2.0
# THEOGONY_REPORT__ANOMALY__COST_SPIKE_MULTIPLIER=1.5
# THEOGONY_REPORT__ANOMALY__COST_SPIKE_MIN_HISTORY=5
# THEOGONY_REPORT__ANOMALY__WIKIDATA_FAILURE_RATE=0.10
# THEOGONY_REPORT__ANOMALY__EMBEDDING_SKEW_STDDEV_MULTIPLIER=3.0

# OneirosTickReport JSON retention:
# THEOGONY_REPORT__ONEIROS_TICK_RETENTION=100

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# THEOGONY_DATA_DIR=data
# THEOGONY_LOG_LEVEL=INFO
